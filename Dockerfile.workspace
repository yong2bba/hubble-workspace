FROM node:22-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /src

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY config ./config
COPY packages/editor ./packages/editor
COPY packages/ui ./packages/ui
COPY apps/workspace-web ./apps/workspace-web
COPY apps/workspace-server ./apps/workspace-server

RUN pnpm install --frozen-lockfile --filter @yongjin/hubble-workspace-web... --filter @yongjin/hubble-workspace-server...
RUN pnpm --filter @yongjin/hubble-workspace-web... build
RUN pnpm --filter @yongjin/hubble-workspace-server build
RUN pnpm --filter @yongjin/hubble-workspace-server --prod deploy --legacy /prod/server

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV WORKSPACE_ROOT=/workspace
ENV STATIC_DIR=/app/public
ENV PUBLIC_PORT=3000
ENV MCP_PORT=3001
WORKDIR /app
RUN install -d -o node -g node /workspace /app/public /app/server
COPY --from=builder --chown=node:node /prod/server /app/server
COPY --from=builder --chown=node:node /src/apps/workspace-web/dist /app/public
USER node
EXPOSE 3000 3001
VOLUME ["/workspace"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "/app/server/dist/index.js"]
